# Supabase project connection string
# Project Settings -> Database -> Connection string (use the "Transaction" pooler
# string for serverless/Fargate, or the direct connection for local dev).
# IMPORTANT: when using the Transaction pooler (port 6543), append
# ?pgbouncer=true -- it tells Prisma to stop using named prepared statements,
# which PgBouncer's transaction mode doesn't support (each query can land on a
# different underlying Postgres connection, causing "prepared statement ...
# does not exist" errors on almost every request).
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Project Settings -> API -> Project URL (or the "Data API" section)
# Used to verify Supabase-issued access tokens against the project's public
# JWKS endpoint: https://[PROJECT-REF].supabase.co/auth/v1/jwks
SUPABASE_URL="https://your-project-ref.supabase.co"

# Only needed as a fallback if Project Settings -> JWT Keys shows ONLY a
# "Legacy JWT Secret" (no JWT Signing Keys yet) -- see the comment in
# src/auth/guards/supabase-auth.guard.ts for the alternate verification code.
# SUPABASE_JWT_SECRET="your-legacy-jwt-secret-here"

# Project Settings -> API -> service_role secret. NEVER expose this to the
# frontend or commit a real value -- it bypasses RLS entirely. Used only by
# the admin-only POST /team/invite endpoint (src/team) to create Supabase
# Auth accounts for new teammates and email them an invite link.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

PORT=3000

# Dashboard origins allowed to call this API (comma-separated). Add the deployed
# frontend's URL here once it's live.
ALLOWED_ORIGINS="http://localhost:5173"

# --- Required by the worker (src/worker) ---

# Redis, used as the BullMQ job queue between the API and the worker.
# Easiest local option: `docker run -p 6379:6379 redis`
REDIS_URL="redis://localhost:6379"

# console.anthropic.com -> API Keys. Used for AI extraction/summary/sentiment.
ANTHROPIC_API_KEY="sk-ant-api03-..."

# console.deepgram.com -> API Keys. Used for speech-to-text.
DEEPGRAM_API_KEY="..."

# Cloudflare R2 (or swap for AWS S3 -- see src/worker/providers/storage.provider.ts)
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET="call-recordings"

# Exotel (telephony provider) -- console.exotel.com -> Settings -> API Credentials.
# Required in BOTH the web and worker services: Exotel's Passthru webhook only
# sends a CallSid, not the recording -- the worker uses these to look up the
# real call details (recording URL, duration) and to authenticate the
# recording download itself (see exotel.provider.ts).
EXOTEL_ACCOUNT_SID="..."
EXOTEL_API_KEY="..."
EXOTEL_API_TOKEN="..."

# MSG91 (SMS) -- control.msg91.com -> Settings -> Authkey. Required in the
# web service, which sends the alert right from the call-completed webhook.
# MSG91_TEMPLATE_ID stays blank until DLT registration (Sender ID + an
# approved message template) is done -- sending is a no-op until then.
MSG91_AUTH_KEY="..."
MSG91_TEMPLATE_ID="..."

# WhatsApp Calling webhook (src/whatsapp). WHATSAPP_VERIFY_TOKEN is any
# string you choose -- enter the same value in Meta's App Dashboard when
# configuring the Callback URL. WHATSAPP_APP_SECRET is from the app's
# Basic Settings in Meta Business Manager, used to verify the
# X-Hub-Signature-256 header on incoming webhook events.
WHATSAPP_VERIFY_TOKEN="..."
WHATSAPP_APP_SECRET="..."

# resend.com -> API Keys. Shared by two features: the missed/completed call
# notification email (src/webhooks/call-notification.provider.ts, recipients
# in CALL_NOTIFICATION_EMAILS) and the new-device login alert (src/auth/
# login-notification.email.ts, recipients in LOGIN_NOTIFICATION_EMAILS).
# Both are no-ops (logged, not thrown) until this key is set.
RESEND_API_KEY="re_..."
CALL_NOTIFICATION_EMAILS="you@example.com"

# Who gets emailed when a user (existing or brand new) signs in from a
# browser/OS/device combo not seen before for their account -- comma-
# separated for multiple recipients. See src/auth/login-tracking.service.ts.
LOGIN_NOTIFICATION_EMAILS="you@example.com"
