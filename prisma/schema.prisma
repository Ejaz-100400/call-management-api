generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model User {
  id                String           @id @db.Uuid
  name              String
  email             String           @unique
  role              UserRole         @default(viewer)
  // Separate from `role` on purpose -- reserved for a single specific
  // person (the business owner), not every admin. Deliberately not folded
  // into the role enum, since granting "admin" for day-to-day management
  // shouldn't also grant whatever this is used to gate.
  isOwner           Boolean          @default(false) @map("is_owner")
  active            Boolean          @default(true)
  lastLoginAt       DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  auditLogs         AuditLog[]
  editedExtractions CallExtraction[] @relation("EditedBy")
  importedCalls     Call[]           @relation("ImportedBy")
  enteredSales      Sale[]
  enteredEnquiries  InPersonEnquiry[]
  stockMovements    StockMovement[]
  devices           UserDevice[]
  users             users            @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("users")
  @@schema("public")
}

// One row per (user, browser+OS+device-type combination) actually seen at
// login -- not per physical device (a web app can't tell two identical
// Windows/Chrome laptops apart), and not per session/request. Recorded once
// per fresh sign-in (see AuthController.me()), which is what makes the
// fingerprint meaningful: a page refresh or token auto-refresh doesn't
// create a new row, only an actual new sign-in does. New fingerprint for a
// user -> "new device" email; an existing one just updates lastSeenAt.
model UserDevice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fingerprint String
  deviceLabel String   @map("device_label")
  deviceType  String   @map("device_type")
  browser     String?
  os          String?
  ipAddress   String?  @map("ip_address")
  city        String?
  region      String?
  country     String?
  // Set only when the browser granted the Geolocation permission -- far more
  // accurate than the IP lookup above, which a VPN/Cloudflare WARP can push
  // hundreds of miles off. locationSource records which one city/region/
  // country actually came from, so the UI can label accordingly.
  lat            Float?
  lng            Float?
  locationSource String?  @map("location_source")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  loginCount  Int      @default(1) @map("login_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, fingerprint])
  @@map("user_devices")
  @@schema("public")
}

model Employee {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String?           @unique
  phone     String?
  role      String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  calls     Call[]
  followUps FollowUp[]
  coverage  NumberCoverage[]
  enquiries InPersonEnquiry[]

  @@map("employees")
  @@schema("public")
}

// Who covers an employee-facing number, and when -- decoupled from
// Employee.phone because a shared number (e.g. one Car Modifications line)
// can be handled by different people at different times of day, and one
// person can cover more than one number. startHour/endHour are IST hours
// (0-23); a row with both null means "always" (no shift restriction, used
// for numbers with a single owner); endHour < startHour means the window
// wraps past midnight (e.g. 18 -> 10 covers 6pm to 10am the next day).
// isBackup rows are shown on the Team Coverage page but deliberately
// excluded from automatic call assignment (resolveForCall in
// employees.service.ts) -- backup is for staff to call on manually, not a
// silent default.
model NumberCoverage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String   @map("phone_number")
  employeeId  String   @map("employee_id") @db.Uuid
  startHour   Int?     @map("start_hour")
  endHour     Int?     @map("end_hour")
  isBackup    Boolean  @default(false) @map("is_backup")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([phoneNumber], map: "idx_number_coverage_phone")
  @@map("number_coverage")
  @@schema("public")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  phoneNumber String   @unique @map("phone_number")
  notes       String?
  // Carried forward from the most recent call's AI extraction / manual edit,
  // so a returning customer's vehicle details don't need re-entering every
  // time they call -- see backfillCustomerVehicleInfo in process-call.ts and
  // the propagation in calls.service.ts's updateExtraction.
  carMake     String?  @map("car_make")
  carModel    String?  @map("car_model")
  carVariant  String?  @map("car_variant")
  location    String?
  // A lightweight personal/team flag for "keep an eye on this one" --
  // deliberately separate from FollowUp's own status workflow (pending/
  // completed/missed), since that's a structured task tied to a specific
  // call, while a bookmark is just "this customer matters" with no status
  // to manage. Any signed-in user can toggle it (see the controller).
  bookmarked   Boolean   @default(false)
  bookmarkedAt DateTime? @map("bookmarked_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  calls       Call[]
  sales       Sale[]
  enquiries   InPersonEnquiry[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_customers_name_trgm", type: Gin)
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], map: "idx_customers_phone_trgm", type: Gin)
  @@map("customers")
  @@schema("public")
}

model Call {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalCallId      String?          @unique @map("external_call_id")
  direction           CallDirection    @default(inbound)
  channel             Channel          @default(phone)
  businessCategory    BusinessCategory @map("business_category")
  // Which physical location this customer was ultimately routed to. The
  // team answers every call at Ambattur (the headquarters) and redirects
  // from there when a customer is nearer one of the other three branches --
  // tracked from here on rather than backfilled onto older calls, since
  // there's no reliable way to know it for those retroactively.
  branch              Branch?
  employeeId          String?          @map("employee_id") @db.Uuid
  customerId          String?          @map("customer_id") @db.Uuid
  callDate            DateTime         @map("call_date") @db.Timestamptz(6)
  durationSeconds     Int              @default(0) @map("duration_seconds")
  recordingStorageKey String?          @map("recording_storage_key")
  status              CallStatus       @default(pending)
  failureReason       String?          @map("failure_reason")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  importedByUserId    String?          @map("imported_by_user_id") @db.Uuid
  extraction          CallExtraction?
  products            CallProduct[]
  customer            Customer?        @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  employee            Employee?        @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  importedBy          User?            @relation("ImportedBy", fields: [importedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  followUps           FollowUp[]
  transcript          Transcript?
  matchedSales        Sale[]

  @@index([businessCategory], map: "idx_calls_business_category")
  @@index([callDate(sort: Desc)], map: "idx_calls_call_date")
  @@index([customerId], map: "idx_calls_customer")
  @@index([employeeId], map: "idx_calls_employee")
  @@index([status], map: "idx_calls_status")
  @@map("calls")
  @@schema("public")
}

// A completed sale, entered by staff at end of day (Customer Tracker page).
// Deliberately not auto-created from a Call or FollowUp -- a phone
// conversation or a walk-in enquiry is an intent signal, a Sale is staff
// directly confirming money actually changed hands. customerId/matchedCallId
// are set at creation time by looking up the phone number against existing
// Customer/Call records (see SalesService.match), not maintained afterward.
model Sale {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerPhone   String     @map("customer_phone")
  customerId      String?    @map("customer_id") @db.Uuid
  carMake         String?    @map("car_make")
  carModel        String?    @map("car_model")
  branch          Branch
  saleDate        DateTime   @map("sale_date") @db.Date
  source          SaleSource @default(unknown)
  matchedCallId   String?    @map("matched_call_id") @db.Uuid
  notes           String?
  enteredByUserId String     @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  customer        Customer?  @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  matchedCall     Call?      @relation(fields: [matchedCallId], references: [id], onUpdate: NoAction)
  enteredBy       User       @relation(fields: [enteredByUserId], references: [id], onUpdate: NoAction)

  @@index([saleDate(sort: Desc)], map: "idx_sales_sale_date")
  @@index([customerId], map: "idx_sales_customer")
  @@index([branch], map: "idx_sales_branch")
  @@map("sales")
  @@schema("public")
}

// A walk-in at one of the four branches, whether or not they bought --
// tracks its own conversion funnel (outcome) separate from the phone/
// WhatsApp funnel Sale.source covers. No reminder/alert is tied to this one
// (see CustomerTracker's tab split) -- staff log it whenever it happens.
model InPersonEnquiry {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerPhone   String?        @map("customer_phone")
  customerId      String?        @map("customer_id") @db.Uuid
  customerName    String?        @map("customer_name")
  carMake         String?        @map("car_make")
  carModel        String?        @map("car_model")
  branch          Branch
  enquiryDate     DateTime       @map("enquiry_date") @db.Date
  outcome         EnquiryOutcome @default(undecided)
  notes           String?
  employeeId      String?        @map("employee_id") @db.Uuid
  enteredByUserId String         @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  customer        Customer?      @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  employee        Employee?      @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  enteredBy       User           @relation(fields: [enteredByUserId], references: [id], onUpdate: NoAction)

  @@index([enquiryDate(sort: Desc)], map: "idx_enquiries_enquiry_date")
  @@index([customerId], map: "idx_enquiries_customer")
  @@index([branch], map: "idx_enquiries_branch")
  @@map("in_person_enquiries")
  @@schema("public")
}

// A trackable inventory item -- category mirrors Product's (car glasses /
// car modifications) since that's the taxonomy the business already
// thinks in, but this is a separate list from the customer-facing Product
// catalog since not every product needs stock tracking (e.g. a service
// like Doom cleaning) and stock items are meant to be added incrementally
// rather than derived from the catalog.
model StockItem {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  category         BusinessCategory
  unit             String          @default("pcs")
  reorderThreshold Int             @default(0) @map("reorder_threshold")
  active           Boolean         @default(true)
  productId        String?         @map("product_id") @db.Uuid
  // Which physical box this item lives in at the Warehouse -- only
  // meaningful there (branches don't box-organize stock), but not
  // enforced at the schema level since nothing stops naming a branch item
  // too if that ever becomes useful.
  boxNumber        String?         @map("box_number")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  movements        StockMovement[]
  swapPartnerOf    StockMovement[] @relation("SwapRelatedItem")

  @@map("stock_items")
  @@schema("public")
}

// Current on-hand quantity per item/branch is never stored directly --
// it's always the sum of `in` movements minus `out` movements, so the
// movement log is the single source of truth (same reasoning as a ledger)
// and there's nothing to keep in sync or drift out of date.
model StockMovement {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockItemId     String            @map("stock_item_id") @db.Uuid
  location        StockLocation
  type            StockMovementType
  quantity        Int
  reason          String?
  // A branch transfer creates two rows (an `out` at the source, an `in` at
  // the destination) sharing one transferId, so they render as a linked
  // pair -- relatedLocation is the *other* row's location, letting the UI
  // show "To Kattankulathur" / "From Ambattur" without parsing free text.
  // Both stay null for an ordinary (non-transfer) movement.
  transferId      String?           @map("transfer_id") @db.Uuid
  relatedLocation StockLocation?    @map("related_location")
  // A swap creates two rows the same way a transfer does -- an `in` for the
  // product coming back out of the car (returned to stock) and an `out` for
  // the replacement going in -- sharing one swapId. relatedStockItemId is
  // the *other* row's item, so the UI can show "Swapped for LED 140W"
  // without parsing free text. Both stay null for a non-swap movement.
  swapId             String?        @map("swap_id") @db.Uuid
  relatedStockItemId String?        @map("related_stock_item_id") @db.Uuid
  movementDate    DateTime          @map("movement_date") @db.Date
  notes           String?
  enteredByUserId String            @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  stockItem        StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  relatedStockItem StockItem?       @relation("SwapRelatedItem", fields: [relatedStockItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  enteredBy       User              @relation(fields: [enteredByUserId], references: [id], onUpdate: NoAction)

  @@index([stockItemId, location], map: "idx_stock_movements_item_location")
  @@index([movementDate(sort: Desc)], map: "idx_stock_movements_date")
  @@index([transferId], map: "idx_stock_movements_transfer")
  @@map("stock_movements")
  @@schema("public")
}

model Transcript {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId    String   @unique @map("call_id") @db.Uuid
  rawText   String   @map("raw_text")
  language  String?
  provider  String?
  diarized  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([rawText(ops: raw("gin_trgm_ops"))], map: "idx_transcripts_text_trgm", type: Gin)
  @@map("transcripts")
  @@schema("public")
}

model CallExtraction {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId               String            @unique @map("call_id") @db.Uuid
  customerName         String?           @map("customer_name")
  phoneNumber          String?           @map("phone_number")
  businessCategory     BusinessCategory? @map("business_category")
  carMake              String?           @map("car_make")
  carModel             String?           @map("car_model")
  carVariant           String?           @map("car_variant")
  location             String?
  productsDiscussed    Json              @default("[]") @map("products_discussed")
  customerRequirements String?           @map("customer_requirements")
  budget               Decimal?          @db.Decimal(12, 2)
  followUpRequired     Boolean           @default(false) @map("follow_up_required")
  followUpDate         DateTime?         @map("follow_up_date") @db.Date
  summary              String?
  sentiment            SentimentType?
  extractedByModel     String?           @map("extracted_by_model")
  extractedAt          DateTime?         @map("extracted_at") @db.Timestamptz(6)
  editedBy             String?           @map("edited_by") @db.Uuid
  editedAt             DateTime?         @map("edited_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  call                 Call              @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  editor               User?             @relation("EditedBy", fields: [editedBy], references: [id], onUpdate: NoAction)

  @@index([businessCategory], map: "idx_extractions_business_cat")
  @@index([carModel(ops: raw("gin_trgm_ops"))], map: "idx_extractions_car_model_trgm", type: Gin)
  @@index([carMake], map: "idx_extractions_car_make")
  @@index([carModel], map: "idx_extractions_car_model_btree")
  @@index([sentiment], map: "idx_extractions_sentiment")
  @@map("call_extractions")
  @@schema("public")
}

model BusinessNumber {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber      String           @unique @map("phone_number")
  // The Exotel ExoPhone this line forwards through -- webhooks always carry
  // this number (not the published phoneNumber above) in their To/CallTo
  // field, since carrier-level forwarding means Exotel never sees the
  // originally-dialed number. Used for category resolution and for
  // recognizing Exotel's internal leg-completion webhooks, kept separate
  // from phoneNumber so the settings page can keep showing the published
  // business line to staff.
  exophoneNumber   String?          @unique @map("exophone_number")
  // Meta's numeric Phone Number ID for this line's WhatsApp Business
  // Platform registration -- calling webhooks identify the number this way,
  // not by the phone number itself (found in WhatsApp Manager > API Setup).
  whatsappPhoneNumberId String?      @unique @map("whatsapp_phone_number_id")
  businessCategory BusinessCategory @map("business_category")
  label            String
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("business_numbers")
  @@schema("public")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  category  BusinessCategory
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  calls     CallProduct[]
  stockItems StockItem[]

  @@map("products")
  @@schema("public")
}

model CallProduct {
  callId    String  @map("call_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  call      Call    @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([callId, productId])
  @@map("call_products")
  @@schema("public")
}

model FollowUp {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Unique: a call gets at most one follow-up task. Without this,
  // process-call.ts's unconditional create() on every (re)processing run
  // silently produced a second row whenever a call was reprocessed --
  // upsert against this constraint now makes that structurally impossible.
  callId      String         @unique @map("call_id") @db.Uuid
  dueDate     DateTime       @map("due_date") @db.Date
  status      FollowUpStatus @default(pending)
  assignedTo  String?        @map("assigned_to") @db.Uuid
  notes       String?
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  employee    Employee?      @relation(fields: [assignedTo], references: [id], onUpdate: NoAction)
  call        Call           @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignedTo], map: "idx_followups_assigned")
  @@map("follow_ups")
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  details   Json?
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([userId], map: "idx_audit_user")
  @@map("audit_logs")
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log_entries {
  instance_id String?   @db.Uuid
  id          String    @id @db.Uuid
  payload     Json?     @db.Json
  created_at  DateTime? @db.Timestamptz(6)
  ip_address  String    @default("") @db.VarChar(64)

  @@index([instance_id], map: "audit_logs_instance_id_idx")
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model custom_oauth_providers {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_type           String
  identifier              String    @unique
  name                    String
  client_id               String
  client_secret           String
  acceptable_client_ids   String[]  @default([])
  scopes                  String[]  @default([])
  pkce_enabled            Boolean   @default(true)
  attribute_mapping       Json      @default("{}")
  authorization_params    Json      @default("{}")
  enabled                 Boolean   @default(true)
  email_optional          Boolean   @default(false)
  issuer                  String?
  discovery_url           String?
  skip_nonce_check        Boolean   @default(false)
  cached_discovery        Json?
  discovery_cached_at     DateTime? @db.Timestamptz(6)
  authorization_url       String?
  token_url               String?
  userinfo_url            String?
  jwks_uri                String?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)
  custom_claims_allowlist String[]  @default([])

  @@index([created_at])
  @@index([enabled])
  @@index([identifier])
  @@index([provider_type])
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flow_state {
  id                     String                 @id @db.Uuid
  user_id                String?                @db.Uuid
  auth_code              String?
  code_challenge_method  code_challenge_method?
  code_challenge         String?
  provider_type          String
  provider_access_token  String?
  provider_refresh_token String?
  created_at             DateTime?              @db.Timestamptz(6)
  updated_at             DateTime?              @db.Timestamptz(6)
  authentication_method  String
  auth_code_issued_at    DateTime?              @db.Timestamptz(6)
  invite_token           String?
  referrer               String?
  oauth_client_state_id  String?                @db.Uuid
  linking_target_id      String?                @db.Uuid
  email_optional         Boolean                @default(false)
  saml_relay_states      saml_relay_states[]

  @@index([created_at(sort: Desc)])
  @@index([auth_code], map: "idx_auth_code")
  @@index([user_id, authentication_method], map: "idx_user_id_auth_method")
