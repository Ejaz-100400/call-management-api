generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model User {
  id                String           @id @db.Uuid
  name              String
  email             String           @unique
  role              UserRole         @default(viewer)
  active            Boolean          @default(true)
  lastLoginAt       DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  auditLogs         AuditLog[]
  editedExtractions CallExtraction[] @relation("EditedBy")
  importedCalls     Call[]           @relation("ImportedBy")
  users             users            @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("users")
  @@schema("public")
}

model Employee {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String?           @unique
  phone     String?
  role      String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  calls     Call[]
  followUps FollowUp[]
  coverage  NumberCoverage[]

  @@map("employees")
  @@schema("public")
}

// Who covers an employee-facing number, and when -- decoupled from
// Employee.phone because a shared number (e.g. one Car Modifications line)
// can be handled by different people at different times of day, and one
// person can cover more than one number. startHour/endHour are IST hours
// (0-23); a row with both null means "always" (no shift restriction, used
// for numbers with a single owner); endHour < startHour means the window
// wraps past midnight (e.g. 18 -> 10 covers 6pm to 10am the next day).
// isBackup rows are shown on the Team Coverage page but deliberately
// excluded from automatic call assignment (resolveForCall in
// employees.service.ts) -- backup is for staff to call on manually, not a
// silent default.
model NumberCoverage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber String   @map("phone_number")
  employeeId  String   @map("employee_id") @db.Uuid
  startHour   Int?     @map("start_hour")
  endHour     Int?     @map("end_hour")
  isBackup    Boolean  @default(false) @map("is_backup")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([phoneNumber], map: "idx_number_coverage_phone")
  @@map("number_coverage")
  @@schema("public")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  phoneNumber String   @unique @map("phone_number")
  notes       String?
  // Carried forward from the most recent call's AI extraction / manual edit,
  // so a returning customer's vehicle details don't need re-entering every
  // time they call -- see backfillCustomerVehicleInfo in process-call.ts and
  // the propagation in calls.service.ts's updateExtraction.
  carMake     String?  @map("car_make")
  carModel    String?  @map("car_model")
  carVariant  String?  @map("car_variant")
  location    String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  calls       Call[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_customers_name_trgm", type: Gin)
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], map: "idx_customers_phone_trgm", type: Gin)
  @@map("customers")
  @@schema("public")
}

model Call {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalCallId      String?          @unique @map("external_call_id")
  direction           CallDirection    @default(inbound)
  businessCategory    BusinessCategory @map("business_category")
  employeeId          String?          @map("employee_id") @db.Uuid
  customerId          String?          @map("customer_id") @db.Uuid
  callDate            DateTime         @map("call_date") @db.Timestamptz(6)
  durationSeconds     Int              @default(0) @map("duration_seconds")
  recordingStorageKey String?          @map("recording_storage_key")
  status              CallStatus       @default(pending)
  failureReason       String?          @map("failure_reason")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  importedByUserId    String?          @map("imported_by_user_id") @db.Uuid
  extraction          CallExtraction?
  products            CallProduct[]
  customer            Customer?        @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  employee            Employee?        @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  importedBy          User?            @relation("ImportedBy", fields: [importedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  followUps           FollowUp[]
  transcript          Transcript?

  @@index([businessCategory], map: "idx_calls_business_category")
  @@index([callDate(sort: Desc)], map: "idx_calls_call_date")
  @@index([customerId], map: "idx_calls_customer")
  @@index([employeeId], map: "idx_calls_employee")
  @@index([status], map: "idx_calls_status")
  @@map("calls")
  @@schema("public")
}

model Transcript {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId    String   @unique @map("call_id") @db.Uuid
  rawText   String   @map("raw_text")
  language  String?
  provider  String?
  diarized  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([rawText(ops: raw("gin_trgm_ops"))], map: "idx_transcripts_text_trgm", type: Gin)
  @@map("transcripts")
  @@schema("public")
}

model CallExtraction {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId               String            @unique @map("call_id") @db.Uuid
  customerName         String?           @map("customer_name")
  phoneNumber          String?           @map("phone_number")
  businessCategory     BusinessCategory? @map("business_category")
  carMake              String?           @map("car_make")
  carModel             String?           @map("car_model")
  carVariant           String?           @map("car_variant")
  location             String?
  productsDiscussed    Json              @default("[]") @map("products_discussed")
  customerRequirements String?           @map("customer_requirements")
  budget               Decimal?          @db.Decimal(12, 2)
  followUpRequired     Boolean           @default(false) @map("follow_up_required")
  followUpDate         DateTime?         @map("follow_up_date") @db.Date
  summary              String?
  sentiment            SentimentType?
  extractedByModel     String?           @map("extracted_by_model")
  extractedAt          DateTime?         @map("extracted_at") @db.Timestamptz(6)
  editedBy             String?           @map("edited_by") @db.Uuid
  editedAt             DateTime?         @map("edited_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  call                 Call              @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  editor               User?             @relation("EditedBy", fields: [editedBy], references: [id], onUpdate: NoAction)

  @@index([businessCategory], map: "idx_extractions_business_cat")
  @@index([carModel(ops: raw("gin_trgm_ops"))], map: "idx_extractions_car_model_trgm", type: Gin)
  @@index([carMake], map: "idx_extractions_car_make")
  @@index([carModel], map: "idx_extractions_car_model_btree")
  @@index([sentiment], map: "idx_extractions_sentiment")
  @@map("call_extractions")
  @@schema("public")
}

model BusinessNumber {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber      String           @unique @map("phone_number")
  // The Exotel ExoPhone this line forwards through -- webhooks always carry
  // this number (not the published phoneNumber above) in their To/CallTo
  // field, since carrier-level forwarding means Exotel never sees the
  // originally-dialed number. Used for category resolution and for
  // recognizing Exotel's internal leg-completion webhooks, kept separate
  // from phoneNumber so the settings page can keep showing the published
  // business line to staff.
  exophoneNumber   String?          @unique @map("exophone_number")
  businessCategory BusinessCategory @map("business_category")
  label            String
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("business_numbers")
  @@schema("public")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  category  BusinessCategory
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  calls     CallProduct[]

  @@map("products")
  @@schema("public")
}

model CallProduct {
  callId    String  @map("call_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  call      Call    @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([callId, productId])
  @@map("call_products")
  @@schema("public")
}

model FollowUp {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId      String         @map("call_id") @db.Uuid
  dueDate     DateTime       @map("due_date") @db.Date
  status      FollowUpStatus @default(pending)
  assignedTo  String?        @map("assigned_to") @db.Uuid
  notes       String?
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  employee    Employee?      @relation(fields: [assignedTo], references: [id], onUpdate: NoAction)
  call        Call           @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignedTo], map: "idx_followups_assigned")
  @@map("follow_ups")
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  details   Json?
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([userId], map: "idx_audit_user")
  @@map("audit_logs")
  @@schema("public")
}

